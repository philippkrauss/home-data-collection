# ---------------------------------------------------------------------------
# Mobilfunk-Collector - Ergaenzung fuer /home/admin/.env auf dem Pi
# Diese Datei ist nur ein Muster. Die echten Werte NIE ins Git-Repo committen.
# Rechte auf dem Pi: chmod 600 /home/admin/.env
# ---------------------------------------------------------------------------

# --- InfluxDB (existiert bereits, hier nur zur Erinnerung) ---
# INFLUX_URL   = https://dein-vps.example.com
# INFLUX_TOKEN = ...
# INFLUX_ORG   = homelab

# Neuer Bucket fuer die Mobilfunkdaten
INFLUX_BUCKET_MOBILFUNK = mobilfunk

# --- Vertraege ---
# Durchnummeriert ab 1, luecken los. NAME ist der Tag in InfluxDB.
# USER ist das, womit man sich auch im Browser anmeldet (Rufnummer oder Kundennummer).
# TARIF_GB ist optional und dient nur als Fallback, falls das Inklusivvolumen
# nicht mehr aus der Seite parsebar ist.

MOBILFUNK_1_NAME     = person1
MOBILFUNK_1_PROVIDER = winsim.de
MOBILFUNK_1_USER     = 01xxxxxxxxxx
MOBILFUNK_1_PASSWORD = xxxxxxxx
MOBILFUNK_1_TARIF_GB = 35

MOBILFUNK_2_NAME     = person2
MOBILFUNK_2_PROVIDER = sim24.de
MOBILFUNK_2_USER     = 01xxxxxxxxxx
MOBILFUNK_2_PASSWORD = xxxxxxxx
MOBILFUNK_2_TARIF_GB = 30

MOBILFUNK_3_NAME     = person3
MOBILFUNK_3_PROVIDER = winsim.de
MOBILFUNK_3_USER     = 01xxxxxxxxxx
MOBILFUNK_3_PASSWORD = xxxxxxxx
# MOBILFUNK_3_TARIF_GB =

# --- Benachrichtigungen (gleicher Bot wie DIUN) ---
TELEGRAM_BOT_TOKEN = 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID   = 123456789

# Fehler-Alerts hoechstens alle 12 h pro Account (Default 43200 s)
# MOBILFUNK_ALERT_COOLDOWN_S = 43200

# --- Upstream-Watcher ---
# Optional. Ohne Token gelten 60 GitHub-API-Requests pro Stunde und IP,
# der Watcher braucht 4 pro Lauf - reicht bei taeglicher Ausfuehrung locker.
# GITHUB_TOKEN = ghp_xxxxxxxxxxxx

# Statusdateien (Defaults, muessen normalerweise nicht gesetzt werden)
# MOBILFUNK_STATE_FILE  = /home/admin/.mobilfunk_state.json
# UPSTREAM_STATE_FILE   = /home/admin/.mobilfunk_upstream.json
