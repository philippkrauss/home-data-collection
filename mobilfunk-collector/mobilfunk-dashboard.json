{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB v2 Datenquelle (Flux-Modus konfiguriert)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Datenvolumen der Drillisch-Vertraege (winSIM / sim24). Daten via mobilfunk_influx.py, stuendlich gescraped. Annahme: Abrechnungsmonat = Kalendermonat.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Verbrauch in % des Inklusivvolumens",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Letzter Messwert je Person. Gelb ab 75 %, Rot ab 90 % - unabhaengig vom Monatsfortschritt.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.person}",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: -48h)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"used_pct\")\n  |> group(columns: [\"person\"])\n  |> last()\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> keep(columns: [\"_value\", \"person\"])"
        }
      ]
    },
    {
      "id": 2,
      "title": "Restvolumen",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Verbleibendes Hochgeschwindigkeits-Datenvolumen im laufenden Abrechnungsmonat.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.person}",
          "unit": "decgbytes",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: -48h)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"remaining_gb\")\n  |> group(columns: [\"person\"])\n  |> last()\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> keep(columns: [\"_value\", \"person\"])"
        }
      ]
    },
    {
      "id": 3,
      "title": "Verbrauch im Monatsverlauf (GB)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Kumulierter Verbrauch seit Monatsbeginn. Springt zum Monatswechsel auf 0 zurueck.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.person}",
          "unit": "decgbytes",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"used_gb\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> keep(columns: [\"_time\", \"_value\", \"person\"])\n  |> group(columns: [\"person\"])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Verbrauch vs. Monatsfortschritt (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Die gestrichelte Soll-Linie ist der lineare Monatsfortschritt. Wer dauerhaft darueber liegt, ist vor Monatsende leer.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.person}",
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"used_pct\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> keep(columns: [\"_time\", \"_value\", \"person\"])\n  |> group(columns: [\"person\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"date\"\n\nmonthStart = date.truncate(t: now(), unit: 1mo)\nmonthEnd = date.add(d: 1mo, to: monthStart)\nspanNs = float(v: int(v: monthEnd) - int(v: monthStart))\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"used_pct\")\n  |> filter(fn: (r) => r.person == \"person1\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: float(v: int(v: r._time) - int(v: monthStart)) / spanNs * 100.0,\n      person: \"Soll (Monatsfortschritt)\"\n  }))\n  |> keep(columns: [\"_time\", \"_value\", \"person\"])\n  |> group(columns: [\"person\"])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Aktueller Stand",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "displayName",
                "value": "Verbraucht %"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "used_gb"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              },
              {
                "id": "displayName",
                "value": "Verbraucht"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "remaining_gb"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              },
              {
                "id": "displayName",
                "value": "Rest"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_gb"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              },
              {
                "id": "displayName",
                "value": "Inklusiv"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "person"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Person"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: -48h)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\")\n  |> filter(fn: (r) => r._field == \"used_gb\" or r._field == \"total_gb\" or r._field == \"remaining_gb\" or r._field == \"used_pct\")\n  |> group(columns: [\"person\", \"_field\"])\n  |> last()\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> pivot(rowKey: [\"person\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"person\", \"used_gb\", \"total_gb\", \"remaining_gb\", \"used_pct\"])"
        }
      ]
    },
    {
      "id": 6,
      "title": "Scraper-Gesundheit (1 = ok, 0 = Parsing/Login kaputt)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 25
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Faellt eine Linie auf 0, hat sich vermutlich die Drillisch-Seite geaendert. Zuerst upstream_watch.py --status pruefen, bevor selbst debuggt wird.",
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.person}",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mobilfunk\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"datenvolumen\" and r._field == \"scrape_ok\")\n  |> aggregateWindow(every: 1h, fn: min, createEmpty: false)\n  |> map(fn: (r) => ({r with person: strings.title(v: r.person)}))\n  |> keep(columns: [\"_time\", \"_value\", \"person\"])\n  |> group(columns: [\"person\"])"
        }
      ]
    }
  ],
  "refresh": "30m",
  "schemaVersion": 38,
  "tags": [
    "mobilfunk",
    "datenvolumen",
    "drillisch"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Mobilfunk Datenvolumen",
  "uid": "mobilfunk-datenvolumen",
  "version": 2
}