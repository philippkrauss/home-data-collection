# ---------------------------------------------------------------------------
# WLANThermo-Collector - Ergaenzung fuer /home/admin/.env auf waerme-pi
# Diese Datei ist nur ein Muster. Die echten Werte NIE ins Git-Repo committen.
# Rechte auf dem Pi: chmod 600 /home/admin/.env
# ---------------------------------------------------------------------------

# --- InfluxDB (existiert bereits, hier nur zur Erinnerung) ---
# INFLUX_URL = https://influx.kraussundco.de
# INFLUX_ORG = homelab

# Neuer Bucket, eigenes Write-Only-Token (bewusst NICHT INFLUX_TOKEN, das
# wuerde in der gemeinsamen .env das Token der anderen Collectors auf diesem
# Pi ueberschreiben)
INFLUX_BUCKET_BBQ = bbq
INFLUX_TOKEN_BBQ  = <write-only Token fuer Bucket "bbq">

# --- WLANThermo ---
# Besser die feste IP als den Hostnamen: nanov3 loest je nach Setup ueber
# mDNS oder den Fritz!Box-DHCP auf. Ein Namensaussetzer mitten in einem
# 12-Stunden-Cook ist vermeidbar - DHCP-Reservierung setzen und IP eintragen.
WLANTHERMO_HOST = nanov3
# WLANTHERMO_URL    = http://192.168.178.xx/data   # ueberschreibt HOST komplett
# WLANTHERMO_DEVICE = nanov3                        # Wert des device-Tags

# --- Optional, Defaults passen fuer den Normalfall ---
# WLANTHERMO_INTERVAL_S      = 10       # Pollintervall
# WLANTHERMO_TIMEOUT_S       = 3        # HTTP-Timeout je Abfrage
# WLANTHERMO_SESSION_GAP_S   = 1800     # ab dieser Ausfallzeit beginnt eine neue Session
# WLANTHERMO_SPOOL_MAX_BYTES = 10485760 # Sicherheitsnetz gegen volllaufende SD-Karte (10 MB)
# WLANTHERMO_LOGLEVEL        = INFO     # DEBUG zeigt auch die "nicht erreichbar"-Zeilen

# Statusverzeichnis (state.json, spool.lp). Absolut angeben.
WLANTHERMO_STATE_DIR = /home/admin/wlanthermo_data
