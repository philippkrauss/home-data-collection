# ---------------------------------------------------------------------------
# Internet-Uptime-Collector - Ergaenzung fuer /home/admin/.env auf waerme-pi
# Diese Datei ist nur ein Muster. Die echten Werte NIE ins Git-Repo committen.
# Rechte auf dem Pi: chmod 600 /home/admin/.env
# ---------------------------------------------------------------------------

# --- InfluxDB (existiert bereits, hier nur zur Erinnerung) ---
# INFLUX_URL = https://dein-vps.example.com
# INFLUX_ORG = homelab

# Neuer Bucket, eigenes Write-Only-Token (bewusst NICHT INFLUX_TOKEN, das
# wuerde in der gemeinsamen .env das Token der anderen Collectors auf diesem
# Pi ueberschreiben)
INFLUX_BUCKET_INTERNET = internet
INFLUX_TOKEN_INTERNET  = <write-only Token fuer Bucket "internet">

# --- Fritz!Box (existiert vermutlich bereits durch fritz_box_export, hier nur
#     zur Erinnerung - falls noch nicht gesetzt, aus dessen .env uebernehmen) ---
# FRITZ_ADDRESS  = 192.168.178.1
# FRITZ_USER     = ...
# FRITZ_PASSWORD = ...

# --- Optional, Defaults passen fuer den Normalfall ---
# DNS_CHECK_HOST   = dein-vps.example.com   # Ziel fuer den DNS-Check (Measurement "dns")
# PING_TIMEOUT_S   = 2                       # Sekunden pro Ping (-W)
# GAP_THRESHOLD_S  = 180                     # ab wann eine Luecke seit dem letzten Lauf als "gap" gilt
# SPOOL_MAX_BYTES  = 10485760                # Sicherheitsnetz gegen volllaufende SD-Karte (10 MB)

# Statusverzeichnis (state.json + spool.lp). Absolut angeben, weil Cron ein
# anderes Working Directory hat als eine interaktive Shell.
STATE_DIR = /home/admin/internet_uptime_data
